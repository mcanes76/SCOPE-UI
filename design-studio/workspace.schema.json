{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCOPE Workspace Settings v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "layout": {
      "enum": [
        "single",
        "split",
        "stacked"
      ]
    },
    "left": {
      "enum": [
        "blos",
        "display",
        "calibration",
        "los"
      ]
    },
    "right": {
      "enum": [
        "blos",
        "display",
        "calibration",
        "los"
      ]
    },
    "ratio": {
      "type": "number",
      "minimum": 10,
      "maximum": 90
    },
    "focused": {
      "enum": [
        "left",
        "right"
      ]
    },
    "expanded": {
      "enum": [
        null,
        "left",
        "right"
      ]
    },
    "previousLayout": {
      "enum": [
        "single",
        "split",
        "stacked"
      ]
    },
    "minPaneWidth": {
      "type": "number",
      "minimum": 160,
      "maximum": 640
    },
    "minPaneHeight": {
      "type": "number",
      "minimum": 120,
      "maximum": 480
    },
    "allowedLayouts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "single",
          "split",
          "stacked"
        ]
      }
    },
    "popout": {
      "type": "boolean"
    },
    "preserveViews": {
      "type": "boolean"
    },
    "windowed": {
      "type": "boolean",
      "default": true,
      "description": "Managed windows by default; false retains legacy single/split/stacked layouts."
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialized",
        "active",
        "items"
      ],
      "properties": {
        "initialized": {
          "type": "boolean"
        },
        "active": {
          "enum": [
            null,
            "blos",
            "display",
            "calibration",
            "los"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "app",
              "rect",
              "restore",
              "state",
              "beforeMinimize",
              "dock"
            ],
            "properties": {
              "app": {
                "enum": [
                  "blos",
                  "display",
                  "calibration",
                  "los"
                ]
              },
              "rect": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "width": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "height": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100000
                  }
                }
              },
              "restore": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "width": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "height": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100000
                  }
                }
              },
              "state": {
                "enum": [
                  "normal",
                  "maximized",
                  "minimized",
                  "closed"
                ]
              },
              "beforeMinimize": {
                "enum": [
                  "normal",
                  "maximized"
                ]
              },
              "dock": {
                "enum": [
                  "none",
                  "left",
                  "right"
                ]
              }
            }
          }
        }
      }
    }
  }
}
